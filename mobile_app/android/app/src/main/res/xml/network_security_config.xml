<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (HTTP) liberado SOMENTE para o portal cativo da UEMA e para o
  probe de conectividade. Todo o restante do tráfego do app exige TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.25.50.10</domain>
        <domain includeSubdomains="true">msftconnecttest.com</domain>
    </domain-config>
</network-security-config>
